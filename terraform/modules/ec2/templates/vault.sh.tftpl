## Vault (integrated raft, awskms auto-unseal, registered in Consul)

# Consul client: gives this node .consul DNS and lets Vault register itself.

install -d -o consul -g consul -m 0750 /opt/consul /etc/consul.d

cat > /etc/consul.d/consul.hcl <<EOF
datacenter = "${consul_datacenter}"
data_dir   = "/opt/consul"
log_level  = "INFO"
node_name  = "$${INSTANCE_ID}"
server     = false

bind_addr      = "$${PRIVATE_IP}"
advertise_addr = "$${PRIVATE_IP}"
client_addr    = "127.0.0.1"

retry_join = ["provider=aws region=$${REGION} tag_key=${join_tag_key} tag_value=${consul_join_tag}"]
EOF

chown -R consul:consul /etc/consul.d
start_service consul

# Vault

systemctl stop vault 2>/dev/null || true
mount_data_volume /opt/vault
install -d -o vault -g vault -m 0750 /opt/vault/data /etc/vault.d
chown -R vault:vault /opt/vault

cat > /etc/vault.d/vault.hcl <<EOF
ui            = true
cluster_name  = "${project_name}"
disable_mlock = true   # recommended with integrated storage

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "$${INSTANCE_ID}"

  retry_join {
    auto_join        = "provider=aws region=$${REGION} tag_key=${join_tag_key} tag_value=${vault_join_tag}"
    auto_join_scheme = "http"
    auto_join_port   = ${ports.vault.api}
  }
}

listener "tcp" {
  address         = "0.0.0.0:${ports.vault.api}"
  cluster_address = "0.0.0.0:${ports.vault.cluster}"
  tls_disable     = true
}

seal "awskms" {
  region     = "$${REGION}"
  kms_key_id = "${vault_kms_key_id}"
}

# Publishes vault.service.consul, plus active. and standby. variants.
service_registration "consul" {
  address = "127.0.0.1:${ports.consul.http}"
}

api_addr     = "http://$${PRIVATE_IP}:${ports.vault.api}"
cluster_addr = "http://$${PRIVATE_IP}:${ports.vault.cluster}"
EOF

chown -R vault:vault /etc/vault.d
start_service vault

%{ if bootstrap_enabled ~}
%{ if snapshot_bucket != "" ~}
# Snapshots. Terraform interpolates into the quoted heredocs below; bash does
# not, so everything written as $${...} expands when the script runs.
cat > /usr/local/bin/vault-snapshot.sh <<'SNAP'
#!/usr/bin/env bash
# Saves a raft snapshot to S3. The timer runs on every Vault node; only the
# active one does the work.
set -euo pipefail
source /etc/hashistack/bootstrap.env

export VAULT_ADDR="http://127.0.0.1:${ports.vault.api}"
BUCKET="${snapshot_bucket}"

curl -fsS "$${VAULT_ADDR}/v1/sys/leader" 2>/dev/null | jq -e '.is_self == true' >/dev/null || exit 0
# Never snapshot the throwaway Vault that exists in the middle of a restore.
[ ! -f /opt/vault/.restore-pending ] || exit 0

# The node proves who it is with its IAM role; no token is stored anywhere.
VAULT_TOKEN="$(vault login -method=aws -token-only role=snapshot)"
export VAULT_TOKEN

tmp="$(mktemp -d)"
trap 'rm -rf "$${tmp}"' EXIT

vault operator raft snapshot save "$${tmp}/vault.snap"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
aws s3 cp --only-show-errors --region "$${REGION}" "$${tmp}/vault.snap" "s3://$${BUCKET}/vault/history/$${stamp}.snap"
aws s3 cp --only-show-errors --region "$${REGION}" "$${tmp}/vault.snap" "s3://$${BUCKET}/vault/latest.snap"
echo "==> snapshot $${stamp} saved"
%{ for c in snapshot_copies ~}

# Second copy for the other site. A failure here must not fail the snapshot.
if aws s3 cp --only-show-errors --region "${c.region}" "$${tmp}/vault.snap" "s3://${c.bucket_name}/vault/history/$${stamp}.snap" \
  && aws s3 cp --only-show-errors --region "${c.region}" "$${tmp}/vault.snap" "s3://${c.bucket_name}/vault/latest.snap"; then
  echo "==> snapshot $${stamp} copied to ${c.bucket_name}"
else
  echo "==> WARNING: copy to ${c.bucket_name} failed" >&2
fi
%{ endfor ~}

SNAP
chmod 0755 /usr/local/bin/vault-snapshot.sh

cat > /etc/systemd/system/vault-snapshot.service <<EOF
[Unit]
Description=Vault raft snapshot to S3
After=vault.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/bin/vault-snapshot.sh
EOF

cat > /etc/systemd/system/vault-snapshot.timer <<EOF
[Unit]
Description=Vault raft snapshot every ${snapshot_interval} minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=${snapshot_interval}min
AccuracySec=30s

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now vault-snapshot.timer

%{ endif ~}
# One-time init, or restore from the latest snapshot when one exists.
cat > /usr/local/bin/vault-bootstrap.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
source /etc/hashistack/bootstrap.env
source /usr/local/lib/hashistack/lock.sh

export VAULT_ADDR="http://127.0.0.1:${ports.vault.api}"
INIT_SECRET="${vault_init_secret}"
SNAPSHOT_BUCKET="${snapshot_bucket}"
SNAPSHOT_KEY="vault/latest.snap"
RESTORE_MARKER="/opt/vault/.restore-pending"

vault_initialized() {
  local out
  out="$(vault status -format=json 2>/dev/null || true)"
  grep -q '"initialized": true' <<<"$${out}"
}

# Initialized with real data, as opposed to the throwaway init of an
# unfinished restore.
vault_has_data() {
  vault_initialized && [ ! -f "$${RESTORE_MARKER}" ]
}
vault_active() {
  curl -fsS "$${VAULT_ADDR}/v1/sys/leader" 2>/dev/null | jq -e '.is_self == true' >/dev/null
}

# vault status exit codes: 0 unsealed, 2 sealed (but listening), 1 unreachable.
wait_listening() {
  local rc
  for _ in $(seq 1 60); do
    rc=0
    vault status >/dev/null 2>&1 || rc=$?
    [ "$${rc}" -ne 1 ] && return 0
    sleep 5
  done
  echo "==> vault is not listening" >&2
  return 1
}

wait_active() {
  for _ in $(seq 1 60); do
    vault_active && return 0
    sleep 5
  done
  echo "==> vault did not become active" >&2
  return 1
}

snapshot_exists() {
  local err
  for _ in 1 2 3; do
    if err="$(aws s3api head-object \
        --region "$${REGION}" \
        --bucket "$${SNAPSHOT_BUCKET}" \
        --key "$${SNAPSHOT_KEY}" 2>&1 >/dev/null)"; then
      return 0
    fi
    if grep -Eq '\(404\)|Not Found' <<<"$${err}"; then
      return 1
    fi
    sleep 5
  done
  # Guessing here could initialize a second, empty Vault. Stop instead.
  echo "==> cannot tell whether a snapshot exists: $${err}" >&2
  exit 1
}

# Lets the node's own IAM role log in and read snapshots, nothing else.
# Safe to re-run. Needs VAULT_TOKEN.
configure_snapshot_auth() {
  { vault auth list -format=json | jq -e '."aws/"' >/dev/null || vault auth enable aws; } \
    && vault policy write snapshot - <<'POLICY' \
    && vault write auth/aws/role/snapshot \
         auth_type=iam \
         bound_iam_principal_arn="${snapshot_role_pattern}" \
         resolve_aws_unique_ids=false \
         token_policies=snapshot \
         token_ttl=10m \
         token_max_ttl=10m
path "sys/storage/raft/snapshot" {
  capabilities = ["read"]
}
POLICY
}

init_vault() {
  # Re-check under the lock. A node that already joined, or a cluster whose
  # keys are already in Secrets Manager, must never be initialized again.
  if vault_initialized || secret_has_value "$${INIT_SECRET}"; then
    echo "==> vault already initialized, skipping"
    return 0
  fi

  local init_json ok=0
  # Auto-unseal means these are recovery keys, not unseal keys.
  init_json="$(vault operator init \
    -recovery-shares=5 \
    -recovery-threshold=3 \
    -format=json)"

  aws secretsmanager put-secret-value \
    --region "$${REGION}" \
    --secret-id "$${INIT_SECRET}" \
    --secret-string "$${init_json}" >/dev/null
  echo "==> vault initialized, credentials written to Secrets Manager"

  VAULT_TOKEN="$(jq -r .root_token <<<"$${init_json}")"
  export VAULT_TOKEN
  wait_active || true

%{ if snapshot_bucket != "" ~}
  for _ in $(seq 1 12); do
    if configure_snapshot_auth >/dev/null 2>&1; then
      ok=1
      break
    fi
    sleep 5
  done
  if [ "$${ok}" -eq 1 ]; then
    echo "==> snapshot auth configured"
  else
    echo "==> WARNING: snapshot auth not configured; snapshots will fail" >&2
  fi

%{ endif ~}
%{ if vault_node_count >= 3 ~}
  # Dead-server cleanup needs min-quorum >= 3, so it is skipped on smaller clusters.
  vault operator raft autopilot set-config \
    -cleanup-dead-servers=true \
    -dead-server-last-contact-threshold=10m \
    -min-quorum=${vault_node_count} >/dev/null 2>&1 \
    && echo "==> autopilot configured" \
    || echo "==> WARNING: autopilot not configured" >&2

%{ endif ~}
  unset VAULT_TOKEN
%{ if snapshot_bucket != "" ~}

  # Take the first snapshot now, so an initialized cluster never exists without one.
  /usr/local/bin/vault-snapshot.sh || echo "==> WARNING: first snapshot failed" >&2
%{ endif ~}
}

restore_vault() {
  local tmp init_json

  if [ -f "$${RESTORE_MARKER}" ]; then
    echo "==> an earlier restore did not finish; clearing its throwaway data"
    systemctl stop vault
    find /opt/vault/data -mindepth 1 -delete
    systemctl start vault
    wait_listening
  fi

  tmp="$(mktemp -d)"
  aws s3 cp --only-show-errors --region "$${REGION}" \
    "s3://$${SNAPSHOT_BUCKET}/$${SNAPSHOT_KEY}" "$${tmp}/vault.snap"

  # A snapshot can only be restored into a running, unsealed Vault, so
  # initialize a throwaway one. Its keys and token are discarded: after the
  # restore, the original root token and recovery keys apply again.
  touch "$${RESTORE_MARKER}"
  init_json="$(vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json)"
  VAULT_TOKEN="$(jq -r .root_token <<<"$${init_json}")"
  export VAULT_TOKEN
  wait_active

  vault operator raft snapshot restore -force "$${tmp}/vault.snap"
  unset VAULT_TOKEN
  rm -rf "$${tmp}"

  wait_active
  rm -f "$${RESTORE_MARKER}"
  echo "==> vault restored from s3://$${SNAPSHOT_BUCKET}/$${SNAPSHOT_KEY}"
}

restore_when_alone() {
  local deadline rc
%{ if vault_node_count > 1 ~}
  # Give retry_join a minute first. A node joining a live cluster gets its
  # data from the leader and must not restore over it.
  for _ in $(seq 1 12); do
    if vault_has_data; then
      return 0
    fi
    sleep 5
  done
%{ endif ~}
  deadline=$(( $(date +%s) + 1800 ))
  while [ "$(date +%s)" -lt "$${deadline}" ]; do
    if vault_has_data; then
      return 0
    fi
    acquire_lock vault-restore && rc=0 || rc=$?
    if [ "$${rc}" -eq 0 ]; then
      restore_vault
      release_lock
      return 0
    fi
    sleep 10
  done
  echo "==> timed out waiting to restore" >&2
  return 1
}

wait_listening

if vault_has_data; then
  echo "==> already initialized, nothing to do"
  exit 0
fi

if [ -n "$${SNAPSHOT_BUCKET}" ] && snapshot_exists; then
  restore_when_alone
else
  run_once vault-init init_vault
fi
SCRIPT
chmod 0755 /usr/local/bin/vault-bootstrap.sh

# Wants, not Requires: the restore path stops and starts Vault, and Requires
# would stop this unit along with it.
cat > /etc/systemd/system/vault-bootstrap.service <<EOF
[Unit]
Description=One-time Vault initialization or restore
Wants=vault.service network-online.target
After=vault.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=40min
Environment=HOME=/root
ExecStart=/usr/local/bin/vault-bootstrap.sh

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable vault-bootstrap.service
# --no-block: nodes that lose the election wait up to 30 min in run_once,
# and that should not hold cloud-init hostage.
systemctl start --no-block vault-bootstrap.service
%{ endif ~}