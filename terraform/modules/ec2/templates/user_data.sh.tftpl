#!/usr/bin/env bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

## Instance facts

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
imds() {
  curl -sH "X-aws-ec2-metadata-token: $${TOKEN}" \
    "http://169.254.169.254/latest/meta-data/$${1}"
}

INSTANCE_ID="$(imds instance-id)"
PRIVATE_IP="$(imds local-ipv4)"
AZ="$(imds placement/availability-zone)"
REGION="$${AZ%?}"

echo "==> role=${role} instance=$${INSTANCE_ID} ip=$${PRIVATE_IP} region=$${REGION}"

## Data volume (raft state / Nomad allocs)

mount_data_volume() {
  local mountpoint="$${1}"
  local dev=""

  # Nitro renames /dev/sdf, so find the unmounted, unpartitioned disk instead.
  for candidate in /dev/nvme[0-9]n[0-9] /dev/sd[b-z] /dev/xvd[b-z]; do
    [ -b "$${candidate}" ] || continue
    if [ "$(lsblk -no MOUNTPOINT "$${candidate}" | tr -d '[:space:]')" = "" ] \
      && [ "$(lsblk -no TYPE "$${candidate}")" = "disk" ]; then
      dev="$${candidate}"
      break
    fi
  done

  if [ -z "$${dev}" ]; then
    echo "==> no data volume found, using root disk for $${mountpoint}"
    mkdir -p "$${mountpoint}"
    return 0
  fi

  if ! blkid "$${dev}" >/dev/null 2>&1; then
    echo "==> formatting $${dev}"
    mkfs.ext4 -L data "$${dev}"
  fi

  mkdir -p "$${mountpoint}"
  grep -q "LABEL=data" /etc/fstab || \
    echo "LABEL=data $${mountpoint} ext4 defaults,nofail 0 2" >> /etc/fstab
  mount -a
  echo "==> mounted $${dev} at $${mountpoint}"
}

%{ if bootstrap_enabled ~}
# Single-winner election. Conditional put fails for everyone but the first
# caller, which is the same trick Terraform's S3 backend uses for state locks.
acquire_lock() {
  local lock_id="$${1}"
  aws dynamodb put-item \
    --region "$${REGION}" \
    --table-name "${lock_table}" \
    --item "{\"LockId\":{\"S\":\"$${lock_id}\"},\"state\":{\"S\":\"in-progress\"},\"holder\":{\"S\":\"$${INSTANCE_ID}\"}}" \
    --condition-expression "attribute_not_exists(LockId)" \
    >/dev/null 2>&1
}

mark_lock_done() {
  aws dynamodb update-item \
    --region "$${REGION}" \
    --table-name "${lock_table}" \
    --key "{\"LockId\":{\"S\":\"$${1}\"}}" \
    --update-expression "SET #s = :d" \
    --expression-attribute-names '{"#s":"state"}' \
    --expression-attribute-values '{":d":{"S":"done"}}' >/dev/null
}

wait_for_lock_done() {
  local lock_id="$${1}" timeout="$${2:-600}" waited=0
  while [ "$${waited}" -lt "$${timeout}" ]; do
    local state
    state="$(aws dynamodb get-item \
      --region "$${REGION}" \
      --table-name "${lock_table}" \
      --key "{\"LockId\":{\"S\":\"$${lock_id}\"}}" \
      --query 'Item.state.S' --output text 2>/dev/null || echo "None")"
    [ "$${state}" = "done" ] && return 0
    sleep 10
    waited=$((waited + 10))
  done
  echo "==> timed out waiting for $${lock_id}" >&2
  return 1
}
%{ endif ~}

# Consul agent

%{ if role == "nomad_consul_server" ~}
install -d -o consul -g consul -m 0750 /opt/consul /etc/consul.d

cat > /etc/consul.d/consul.hcl <<EOF
datacenter       = "${consul_datacenter}"
data_dir         = "/opt/consul"
log_level        = "INFO"
node_name        = "$${INSTANCE_ID}"
server           = true
bootstrap_expect = ${bootstrap_expect}

bind_addr   = "$${PRIVATE_IP}"
client_addr = "0.0.0.0"

advertise_addr = "$${PRIVATE_IP}"

retry_join = ["provider=aws region=$${REGION} tag_key=Role tag_value=nomad_consul_server"]

ui_config {
  enabled = true
}

ports {
  http = ${ports.consul.http}
  dns  = ${ports.consul.dns}
}

# Bootstrap posture: no gossip encryption, no mTLS. Both are added once
# Vault is up and can issue the material.
EOF

chown -R consul:consul /etc/consul.d
systemctl enable --now consul
%{ endif ~}

%{ if role == "nomad_worker" || role == "boundary" ~}
install -d -o consul -g consul -m 0750 /opt/consul /etc/consul.d

cat > /etc/consul.d/consul.hcl <<EOF
datacenter = "${consul_datacenter}"
data_dir   = "/opt/consul"
log_level  = "INFO"
node_name  = "$${INSTANCE_ID}"
server     = false

bind_addr      = "$${PRIVATE_IP}"
advertise_addr = "$${PRIVATE_IP}"
client_addr    = "127.0.0.1"

retry_join = ["provider=aws region=$${REGION} tag_key=Role tag_value=nomad_consul_server"]
EOF

chown -R consul:consul /etc/consul.d
systemctl enable --now consul
%{ endif ~}

# Nomad

%{ if role == "nomad_consul_server" ~}
install -d -o nomad -g nomad -m 0750 /opt/nomad /etc/nomad.d

cat > /etc/nomad.d/nomad.hcl <<EOF
datacenter = "${consul_datacenter}"
data_dir   = "/opt/nomad"
name       = "$${INSTANCE_ID}"

bind_addr = "0.0.0.0"

advertise {
  http = "$${PRIVATE_IP}:${ports.nomad.http}"
  rpc  = "$${PRIVATE_IP}:${ports.nomad.rpc}"
  serf = "$${PRIVATE_IP}:${ports.nomad.serf}"
}

server {
  enabled          = true
  bootstrap_expect = ${bootstrap_expect}
}

consul {
  address       = "127.0.0.1:${ports.consul.http}"
  server_auto_join = true
  client_auto_join = true
}
EOF

chown -R nomad:nomad /etc/nomad.d
systemctl enable --now nomad
%{ endif ~}

%{ if role == "nomad_worker" ~}
install -d -m 0755 /opt/nomad
mount_data_volume /opt/nomad
install -d -o nomad -g nomad -m 0750 /opt/nomad /etc/nomad.d

cat > /etc/nomad.d/nomad.hcl <<EOF
datacenter = "${consul_datacenter}"
data_dir   = "/opt/nomad"
name       = "$${INSTANCE_ID}"

bind_addr = "0.0.0.0"

advertise {
  http = "$${PRIVATE_IP}:${ports.nomad.http}"
  rpc  = "$${PRIVATE_IP}:${ports.nomad.rpc}"
  serf = "$${PRIVATE_IP}:${ports.nomad.serf}"
}

client {
  enabled = true

  meta {
    instance_id = "$${INSTANCE_ID}"
    az          = "$${AZ}"
  }
}

consul {
  address = "127.0.0.1:${ports.consul.http}"
}

plugin "docker" {
  config {
    allow_privileged = false
  }
}
EOF

chown -R nomad:nomad /etc/nomad.d
systemctl enable --now nomad
%{ endif ~}

# Vault (integrated raft)

%{ if role == "vault" ~}
mount_data_volume /opt/vault
install -d -o vault -g vault -m 0750 /opt/vault/data /etc/vault.d
chown -R vault:vault /opt/vault

cat > /etc/vault.d/vault.hcl <<EOF
ui           = true
cluster_name = "${project_name}"
disable_mlock = false

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "$${INSTANCE_ID}"

  retry_join {
    auto_join        = "provider=aws region=$${REGION} tag_key=Role tag_value=vault"
    auto_join_scheme = "http"
    auto_join_port   = ${ports.vault.api}
  }

  autopilot {
    cleanup_dead_servers           = true
    dead_server_last_contact_threshold = "10m"
    min_quorum                     = 3
  }
}

listener "tcp" {
  address         = "0.0.0.0:${ports.vault.api}"
  cluster_address = "0.0.0.0:${ports.vault.cluster}"
  tls_disable     = true
}

seal "awskms" {
  region     = "$${REGION}"
  kms_key_id = "${vault_kms_key_id}"
}

api_addr     = "http://$${PRIVATE_IP}:${ports.vault.api}"
cluster_addr = "http://$${PRIVATE_IP}:${ports.vault.cluster}"
EOF

chown -R vault:vault /etc/vault.d
systemctl enable --now vault

%{ if bootstrap_enabled ~}
cat > /usr/local/bin/vault-bootstrap.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
export VAULT_ADDR="http://127.0.0.1:VAULT_PORT"

# Wait for the listener. 501 = uninitialized, 200/429 = up.
for _ in $(seq 1 60); do
  vault status >/dev/null 2>&1 && break
  code=$?
  [ "$code" -eq 2 ] && break   # sealed, which still means listening
  sleep 5
done

if vault status -format=json 2>/dev/null | grep -q '"initialized": true'; then
  echo "==> already initialized, nothing to do"
  exit 0
fi

if ! acquire_lock vault-init; then
  echo "==> another node is initializing; retry_join will pull us in"
  exit 0
fi

# Auto-unseal means these are recovery keys, not unseal keys.
INIT_JSON="$(vault operator init \
  -recovery-shares=5 \
  -recovery-threshold=3 \
  -format=json)"

aws secretsmanager put-secret-value \
  --region "$REGION" \
  --secret-id "VAULT_INIT_SECRET" \
  --secret-string "$INIT_JSON" >/dev/null

mark_lock_done vault-init
echo "==> vault initialized, credentials written to Secrets Manager"
SCRIPT

# The helpers live in this script's environment, so inline them.
sed -i "s|VAULT_PORT|${ports.vault.api}|; s|VAULT_INIT_SECRET|${vault_init_secret}|" \
  /usr/local/bin/vault-bootstrap.sh
sed -i "2r /dev/stdin" /usr/local/bin/vault-bootstrap.sh <<HELPERS
REGION="$${REGION}"
INSTANCE_ID="$${INSTANCE_ID}"
$(declare -f acquire_lock mark_lock_done wait_for_lock_done)
HELPERS
chmod 0755 /usr/local/bin/vault-bootstrap.sh

cat > /etc/systemd/system/vault-bootstrap.service <<EOF
[Unit]
Description=One-time Vault initialization
After=vault.service network-online.target
Requires=vault.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vault-bootstrap.sh
RemainAfterExit=yes
EOF

systemctl daemon-reload
systemctl enable --now vault-bootstrap.service
%{ endif ~}

%{ endif ~}

## Boundary (controller + worker on one instance)

%{ if role == "boundary" ~}
install -d -o boundary -g boundary -m 0750 /opt/boundary /etc/boundary.d

SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$${REGION}" \
  --secret-id "${boundary_db.secret_arn}" \
  --query SecretString --output text)"

DB_USER="$(jq -r .username <<<"$${SECRET_JSON}")"
DB_PASS="$(jq -r .password <<<"$${SECRET_JSON}")"
# RDS-managed passwords contain characters that break URL parsing.
DB_PASS_ENC="$(jq -rn --arg v "$${DB_PASS}" '$v|@uri')"

BOUNDARY_PG_URL="postgresql://$${DB_USER}:$${DB_PASS_ENC}@${boundary_db.host}:${boundary_db.port}/${boundary_db.dbname}?sslmode=require"

cat > /etc/boundary.d/boundary.hcl <<EOF
disable_mlock = true

controller {
  name        = "ctrl-$${INSTANCE_ID}"
  description = "${project_name} controller"

  database {
    url = "env://BOUNDARY_PG_URL"
  }

  public_cluster_addr = "$${PRIVATE_IP}"
}

worker {
  name        = "wrk-$${INSTANCE_ID}"
  description = "${project_name} worker"

  public_addr        = "${boundary_public_addr}"
  initial_upstreams  = ["127.0.0.1:${ports.boundary.cluster}"]
}

listener "tcp" {
  address     = "0.0.0.0:${ports.boundary.api}"
  purpose     = "api"
  tls_disable = true
}

listener "tcp" {
  address     = "0.0.0.0:${ports.boundary.cluster}"
  purpose     = "cluster"
  tls_disable = true
}

listener "tcp" {
  address     = "0.0.0.0:${ports.boundary.proxy}"
  purpose     = "proxy"
  tls_disable = true
}

kms "aws" {
  purpose    = "root"
  region     = "$${REGION}"
  kms_key_id = "${boundary_kms.boundary_root}"
}

kms "aws" {
  purpose    = "worker-auth"
  region     = "$${REGION}"
  kms_key_id = "${boundary_kms.boundary_worker_auth}"
}

kms "aws" {
  purpose    = "recovery"
  region     = "$${REGION}"
  kms_key_id = "${boundary_kms.boundary_recovery}"
}
EOF

## Keep the connection string out of the config file on disk.
install -d -m 0750 -o boundary -g boundary /etc/systemd/system/boundary.service.d
cat > /etc/systemd/system/boundary.service.d/10-db.conf <<EOF
[Service]
Environment="BOUNDARY_PG_URL=$${BOUNDARY_PG_URL}"
EOF
chmod 0600 /etc/systemd/system/boundary.service.d/10-db.conf

chown -R boundary:boundary /etc/boundary.d
chmod 0640 /etc/boundary.d/boundary.hcl

systemctl daemon-reload
%{ if bootstrap_enabled ~}
cat > /usr/local/bin/boundary-bootstrap.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

for _ in $(seq 1 60); do
  pg_isready -h DB_HOST -p DB_PORT >/dev/null 2>&1 && break
  sleep 5
done

if acquire_lock boundary-db-init; then
  INIT_JSON="$(boundary database init \
    -config /etc/boundary.d/boundary.hcl \
    -format json)"

  aws secretsmanager put-secret-value \
    --region "$REGION" \
    --secret-id "BOUNDARY_INIT_SECRET" \
    --secret-string "$INIT_JSON" >/dev/null

  mark_lock_done boundary-db-init
  echo "==> boundary database initialized"
else
  echo "==> another node is migrating; waiting"
  wait_for_lock_done boundary-db-init 900
fi

systemctl start boundary
SCRIPT

sed -i "s|DB_HOST|${boundary_db.host}|; s|DB_PORT|${boundary_db.port}|; s|BOUNDARY_INIT_SECRET|${boundary_init_secret}|" \
  /usr/local/bin/boundary-bootstrap.sh
sed -i "2r /dev/stdin" /usr/local/bin/boundary-bootstrap.sh <<HELPERS
REGION="$${REGION}"
INSTANCE_ID="$${INSTANCE_ID}"
$(declare -f acquire_lock mark_lock_done wait_for_lock_done)
HELPERS
chmod 0755 /usr/local/bin/boundary-bootstrap.sh

cat > /etc/systemd/system/boundary-bootstrap.service <<EOF
[Unit]
Description=One-time Boundary database initialization
After=network-online.target
Before=boundary.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/boundary-bootstrap.sh
RemainAfterExit=yes
EOF

systemctl daemon-reload
systemctl enable --now boundary-bootstrap.service
%{ endif ~}
%{ endif ~}

## Extra, per node group

${extra}

echo "==> user-data complete for ${role}"